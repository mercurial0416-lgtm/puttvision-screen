<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:label="PuttVision Screen"
        android:supportsRtl="true"
        android:theme="@style/Theme.PuttVisionScreen">

        <activity
            android:name=".MainActivity"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- V143: one full-screen Godot instance is launched as a separate task directly on the
             HDMI/DeX presentation display. The phone Activity remains responsible for camera/HFR. -->
        <activity
            android:name=".V143GodotTvActivity"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboard|keyboardHidden|navigation"
            android:excludeFromRecents="true"
            android:exported="false"
            android:resizeableActivity="false"
            android:theme="@style/Theme.PuttVisionScreen" />

        <!-- V149: native coordinator survives child Godot crashes and runs empty engine ->
             production V143 scene -> full SIM LAB as three separately attributable processes. -->
        <activity
            android:name=".V144HardwarelessGodotActivity"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboard|keyboardHidden|navigation"
            android:excludeFromRecents="true"
            android:exported="false"
            android:resizeableActivity="false"
            android:theme="@style/Theme.PuttVisionScreen" />

        <!-- Stage 1: empty Godot Node only. No V143 scene/resources/plugin/GameEngine. -->
        <activity
            android:name=".V148GodotSmokeActivity"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboard|keyboardHidden|navigation"
            android:excludeFromRecents="true"
            android:exported="false"
            android:process=":godot_smoke"
            android:resizeableActivity="false"
            android:theme="@style/Theme.PuttVisionScreen" />

        <!-- Stage 2: exact V143 scene, still without PuttVisionBridge or GameEngine. -->
        <activity
            android:name=".V149GodotSceneSmokeActivity"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboard|keyboardHidden|navigation"
            android:excludeFromRecents="true"
            android:exported="false"
            android:process=":godot_scene"
            android:resizeableActivity="false"
            android:theme="@style/Theme.PuttVisionScreen" />

        <!-- Stage 3: full hardwareless simulator is a third process. -->
        <activity
            android:name=".V148HardwarelessFullActivity"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboard|keyboardHidden|navigation"
            android:excludeFromRecents="true"
            android:exported="false"
            android:process=":hardwareless_full"
            android:resizeableActivity="false"
            android:theme="@style/Theme.PuttVisionScreen" />

        <!-- Godot's AAR also contributes a FileProvider with the same app authority. PuttVision's
             updater owns that provider contract; the TV renderer does not use Godot file sharing. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"
                tools:replace="android:resource" />
        </provider>

    </application>
</manifest>
