<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PuttVisionScreen" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#89F7B0</item>
        <item name="android:windowBackground">#090C10</item>
        <item name="android:statusBarColor">#090C10</item>
        <item name="android:navigationBarColor">#090C10</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:alertDialogTheme">@style/ThemeOverlay.PuttVision.Dialog</item>
    </style>
    <style name="ThemeOverlay.PuttVision.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">#12171E</item>
        <item name="android:colorAccent">#4ED179</item>
        <item name="android:textColorPrimary">#ECF1F7</item>
        <item name="android:textColorSecondary">#96A2B1</item>
        <item name="colorAccent">#4ED179</item>
    </style>
</resources>